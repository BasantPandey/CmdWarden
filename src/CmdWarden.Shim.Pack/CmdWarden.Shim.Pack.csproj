<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CmdWarden.Shim.Pack</RootNamespace>
    <AssemblyName>cw-pack-shim</AssemblyName>
    <Description>One PATH shim for every tool pack. cw harden copies it as &lt;tool&gt;.exe; the file name names the tool.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CmdWarden.Contracts\CmdWarden.Contracts.csproj" />
  </ItemGroup>
</Project>
