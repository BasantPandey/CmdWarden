<Window x:Class="CmdWarden.ApprovalGate.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CmdWarden alarm"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable, Segoe UI">
  <Border Margin="12" Background="#2C2C2C" BorderBrush="#FF99A4" BorderThickness="1" CornerRadius="10" Padding="16,12,12,14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="Heading" FontSize="14" FontWeight="SemiBold" Foreground="#FF99A4" Margin="0,0,0,6" />
        <TextBlock x:Name="Body" FontSize="12.5" Foreground="#E6E6E6" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="24" Height="24"
              VerticalAlignment="Top" Margin="8,-2,0,0" Background="Transparent" BorderThickness="0"
              Foreground="#B8FFFFFF" Cursor="Hand" Click="Close_Click" AutomationProperties.Name="Close" />
    </Grid>
  </Border>
</Window>
