<Window x:Class="CmdWarden.ApprovalGate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CmdWarden.ApprovalGate"
        Title="CmdWarden"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#202020"
        FontFamily="Segoe UI Variable, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Border Margin="16" Background="#2C2C2C" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="24,16,24,20">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Viewbox Width="20" Height="20" Margin="0,0,8,0" Stretch="Uniform">
          <Canvas Width="16" Height="16">
            <Rectangle Width="16" Height="16" RadiusX="3.5" RadiusY="3.5">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#60CDFF" Offset="0" />
                  <GradientStop Color="#0078D4" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Rectangle Canvas.Left="3" Canvas.Top="4" Width="10" Height="3" RadiusX="0.6" RadiusY="0.6" Fill="#F3F3F3" />
            <Rectangle Canvas.Left="3" Canvas.Top="4" Width="3" Height="9" RadiusX="0.6" RadiusY="0.6" Fill="#F3F3F3" />
            <Rectangle Canvas.Left="10" Canvas.Top="4" Width="3" Height="9" RadiusX="0.6" RadiusY="0.6" Fill="#F3F3F3" />
          </Canvas>
        </Viewbox>
        <TextBlock x:Name="BrandTitle" Text="CmdWarden" FontSize="12" FontWeight="SemiBold"
                   Foreground="#B8FFFFFF" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
        <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,12">
          <Border CornerRadius="18" Padding="2">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8C60CDFF" Offset="0" />
                <GradientStop Color="#260078D4" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Border CornerRadius="16" Background="#2A2A2A">
              <Grid>
                <Image x:Name="LauncherIcon" Width="40" Height="40" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="IconGlyph" Text="?" FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Border>
          <Border x:Name="ToolBadge" Width="34" Height="34" CornerRadius="10" Background="#1A1A1A"
                  BorderBrush="#2C2C2C" BorderThickness="2" Padding="6"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-8" Visibility="Collapsed">
            <Image x:Name="ToolIcon" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
        </Grid>
        <TextBlock x:Name="LauncherName" Text="Unknown app" FontSize="22" FontWeight="SemiBold"
                   Foreground="White" HorizontalAlignment="Center" />
        <TextBlock x:Name="Subtitle" Text="WANTS TO RUN" FontSize="11" FontWeight="SemiBold"
                   Foreground="#8CFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0" />
      </StackPanel>

      <Border Background="#1A1A1A" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock x:Name="CommandLine" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="#F3F3F3" TextWrapping="Wrap" />
          <TextBlock x:Name="ToolPath" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                     Foreground="#9EC9E8" TextWrapping="Wrap" Margin="0,6,0,0" />
          <Border Height="1" Background="#18FFFFFF" Margin="0,10,0,8" />
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="CWD" FontSize="10" FontWeight="Bold" Foreground="#8CFFFFFF" />
            <TextBlock x:Name="WorkingDirectory" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                       Foreground="#E6E6E6" TextWrapping="Wrap" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="KEYS" FontSize="10" FontWeight="Bold" Foreground="#8CFFFFFF" />
            <TextBlock x:Name="SecretKeys" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                       Foreground="#E6E6E6" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock x:Name="ReasonHeading" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
      <TextBlock x:Name="ReasonLine" FontSize="13" Foreground="#B8FFFFFF" TextWrapping="Wrap" Margin="0,0,0,12" />

      <Expander Header="Details" IsExpanded="False" Margin="0,0,0,16" Foreground="#60CDFF">
        <StackPanel Margin="0,8,0,0">
          <TextBlock x:Name="DetailEnrollment" Foreground="#B8FFFFFF" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailIdentity" Foreground="#B8FFFFFF" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailPublisher" Foreground="#B8FFFFFF" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailLauncherPath" Foreground="#B8FFFFFF" FontSize="11" FontFamily="Cascadia Mono, Consolas"
                     Margin="0,0,0,4" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailPolicyLevel" Foreground="#B8FFFFFF" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailCommandClass" Foreground="#B8FFFFFF" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailPolicyKey" Foreground="#B8FFFFFF" FontSize="11" FontFamily="Cascadia Mono, Consolas"
                     Margin="0,0,0,4" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailTimestamp" Foreground="#B8FFFFFF" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition x:Name="SessionColumn" Width="*" />
          <ColumnDefinition x:Name="SessionGap" Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="DenyButton" Style="{StaticResource DenyButtonStyle}"
                Height="36" IsCancel="True" Click="DenyButton_Click" ToolTip="Deny (Esc)"
                AutomationProperties.Name="Deny">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Deny" />
            <Border Style="{StaticResource KeyChipStyle}">
              <TextBlock Text="Esc" Style="{StaticResource KeyChipTextStyle}" />
            </Border>
          </StackPanel>
        </Button>
        <local:GatedButton x:Name="SessionButton" Grid.Column="2" Style="{StaticResource DenyButtonStyle}"
                Foreground="{StaticResource AccentBrush}" Height="36" Click="SessionButton_Click" ToolTip="Allow for session (A)"
                AutomationProperties.Name="Allow for session">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Allow for session" />
            <Border Style="{StaticResource KeyChipStyle}">
              <TextBlock Text="A" Style="{StaticResource KeyChipTextStyle}" />
            </Border>
          </StackPanel>
        </local:GatedButton>
        <local:GatedButton x:Name="ApproveButton" Grid.Column="4" Style="{StaticResource ApproveButtonStyle}"
                Height="36" IsDefault="True" Click="ApproveButton_Click" ToolTip="Approve Once (Enter)"
                AutomationProperties.Name="Approve Once">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Approve Once" />
            <Border Style="{StaticResource KeyChipStyle}">
              <TextBlock Text="Enter" Style="{StaticResource KeyChipTextStyle}" />
            </Border>
          </StackPanel>
        </local:GatedButton>
      </Grid>
      <TextBlock x:Name="HelloStatus" Text="Confirm with Windows Hello." FontSize="12" Foreground="#60CDFF"
                 TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />
      <TextBlock x:Name="IgnoredInput" FontSize="12" Foreground="#FFB86C" TextAlignment="Center"
                 HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />
      <TextBlock x:Name="SessionScope" FontSize="11" Foreground="#8CFFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" Margin="0,10,0,0" />
    </StackPanel>
  </Border>
</Window>
