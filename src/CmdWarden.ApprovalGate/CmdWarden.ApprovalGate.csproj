<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CmdWarden.ApprovalGate</AssemblyName>
    <RootNamespace>CmdWarden.ApprovalGate</RootNamespace>
    <Description>CmdWarden Approval Gate helper - modern Fluent-style card. Exit 0=Approve Once, 1=Deny, 2=Unavailable.</Description>
    <Version>0.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>CmdWarden.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CmdWarden.Contracts\CmdWarden.Contracts.csproj" />
  </ItemGroup>
</Project>
