<Window x:Class="CmdWarden.SecretsManager.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1C1C1C"
        Foreground="White"
        FontFamily="Segoe UI Variable, Segoe UI"
        ShowInTaskbar="False">
  <Border Margin="16" Background="#2A2A2A" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="10" Padding="20">
    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
      <TextBlock x:Name="BodyText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,20" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"
                IsCancel="True" Click="Cancel_Click" Padding="16,8" ToolTip="Cancel (Esc)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Cancel" />
            <Border Style="{StaticResource KeyChipStyle}">
              <TextBlock Text="Esc" Style="{StaticResource KeyChipTextStyle}" />
            </Border>
          </StackPanel>
        </Button>
        <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButtonStyle}"
                IsDefault="True" Click="Confirm_Click" Padding="18,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ConfirmLabel" />
            <Border Style="{StaticResource KeyChipStyle}">
              <TextBlock Text="Enter" Style="{StaticResource KeyChipTextStyle}" />
            </Border>
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
