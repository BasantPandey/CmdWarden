<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- #43: the tray icon uses the WinForms NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CmdWarden.SecretsManager</AssemblyName>
    <!-- The file description names the app in Windows notifications and Task Manager. -->
    <AssemblyTitle>CmdWarden Vault</AssemblyTitle>
    <RootNamespace>CmdWarden.SecretsManager</RootNamespace>
    <Description>CmdWarden Vault - secrets manager window (list / add / delete secret names; values never shown).</Description>
    <Version>0.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\CmdWarden.ApprovalGate\CmdWarden.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF names win: no global WinForms or Drawing usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CmdWarden.Contracts\CmdWarden.Contracts.csproj" />
    <Compile Include="..\Shared\BrandImages.cs" Link="BrandImages.cs" />
  </ItemGroup>
</Project>
