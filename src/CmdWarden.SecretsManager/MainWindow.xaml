<Window x:Class="CmdWarden.SecretsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CmdWarden Vault"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#14161C"
        Foreground="White"
        FontFamily="Segoe UI Variable, Segoe UI"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="228" MinWidth="64" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Left nav (A expanded / B icon rail when collapsed) -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True" Margin="8,10,8,10">
        <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="22" Height="22" Margin="4,0,10,0" Stretch="Uniform">
              <Canvas Width="16" Height="16">
                <Rectangle Width="16" Height="16" RadiusX="3.5" RadiusY="3.5">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#60CDFF" Offset="0" />
                      <GradientStop Color="#0078D4" Offset="1" />
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <Rectangle Canvas.Left="3" Canvas.Top="4" Width="10" Height="3" RadiusX="0.6" RadiusY="0.6" Fill="#F3F3F3" />
                <Rectangle Canvas.Left="3" Canvas.Top="4" Width="3" Height="9" RadiusX="0.6" RadiusY="0.6" Fill="#F3F3F3" />
                <Rectangle Canvas.Left="10" Canvas.Top="4" Width="3" Height="9" RadiusX="0.6" RadiusY="0.6" Fill="#F3F3F3" />
              </Canvas>
            </Viewbox>
            <TextBlock x:Name="BrandText" Text="CmdWarden" FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="CollapseButton" Content="&#x00AB;" Width="28" Height="28"
                  Style="{StaticResource IconButtonStyle}" Padding="0"
                  ToolTip="Collapse nav to icon rail" Click="CollapseButton_Click" />
        </Grid>

        <StackPanel>
          <Button x:Name="NavGates" Style="{StaticResource NavButtonStyle}" Tag="gates"
                  Click="NavButton_Click" ToolTip="Secret Gates" Margin="0,1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEA18;" Width="22" TextAlignment="Center" FontSize="15"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
              <TextBlock x:Name="NavGatesLabel" Text="Secret Gates" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="NavDetectors" Style="{StaticResource NavButtonStyle}" Tag="detectors"
                  Click="NavButton_Click" ToolTip="Detectors" Margin="0,1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE721;" Width="22" TextAlignment="Center" FontSize="15"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
              <TextBlock x:Name="NavDetectorsLabel" Text="Detectors" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="NavTools" Style="{StaticResource NavButtonStyle}" Tag="tools"
                  Click="NavButton_Click" ToolTip="Hardened Tools" Margin="0,1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE90F;" Width="22" TextAlignment="Center" FontSize="15"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
              <TextBlock x:Name="NavToolsLabel" Text="Hardened Tools" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSecrets" Style="{StaticResource NavButtonSelectedStyle}" Tag="secrets"
                  Click="NavButton_Click" ToolTip="Secrets" Margin="0,1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8D7;" Width="22" TextAlignment="Center" FontSize="15"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
              <TextBlock x:Name="NavSecretsLabel" Text="Secrets" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="NavUsage" Style="{StaticResource NavButtonStyle}" Tag="usage"
                  Click="NavButton_Click" ToolTip="Secret Usage" Margin="0,1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE81C;" Width="22" TextAlignment="Center" FontSize="15"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
              <TextBlock x:Name="NavUsageLabel" Text="Secret Usage" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="NavDoctor" Style="{StaticResource NavButtonStyle}" Tag="doctor"
                  Click="NavButton_Click" ToolTip="Doctor" Margin="0,1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE95E;" Width="22" TextAlignment="Center" FontSize="15"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
              <TextBlock x:Name="NavDoctorLabel" Text="Doctor" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main content -->
    <DockPanel Grid.Column="1" LastChildFill="True">
      <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitleText" Text="Secrets" FontSize="22" FontWeight="SemiBold" />
            <Border x:Name="AgentBadge" Margin="12,0,0,0" CornerRadius="999" Background="{StaticResource MutedPillBrush}"
                    Padding="9,3" VerticalAlignment="Center" ToolTip="Session Agent status">
              <TextBlock x:Name="AgentBadgeText" Text="Checking..." FontSize="11" FontWeight="Bold"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
            <TextBlock x:Name="PageSubtitleText" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource TextTertiaryBrush}" Visibility="Collapsed" />
          </StackPanel>
          <Button x:Name="PagePrimaryButton" Grid.Column="1" Content="+ Add secret"
                  Style="{StaticResource PrimaryButtonStyle}" Click="PagePrimaryButton_Click" />
        </Grid>
      </Border>

      <!-- Agent banner (secrets page mainly) -->
      <Border x:Name="AgentDownBanner" DockPanel.Dock="Top" Visibility="Collapsed"
              Background="#14FFC83C" BorderBrush="#26FFC83C" BorderThickness="0,0,0,1" Padding="16,10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#9888;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="AgentDownBannerText" Text="Session Agent not running - actions disabled" FontSize="12"
                     Foreground="#BFFFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Pages -->
      <Grid>
        <!-- Secrets (live) -->
        <DockPanel x:Name="PageSecrets" LastChildFill="True">
          <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button x:Name="AddSecretButton" Grid.Column="0"
                      Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                      Click="AddSecretButton_Click" Margin="0,0,6,0" ToolTip="Add secret (Ctrl+N)">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="+ Add secret" />
                  <Border Style="{StaticResource KeyChipStyle}">
                    <TextBlock Text="Ctrl+N" Style="{StaticResource KeyChipTextStyle}" />
                  </Border>
                </StackPanel>
              </Button>
              <Button x:Name="RefreshButton" Grid.Column="1" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                      Style="{StaticResource IconButtonStyle}" ToolTip="Refresh (F5)"
                      Click="RefreshButton_Click" />
              <TextBlock x:Name="SecretCountText" Grid.Column="3" Text="0 secrets" FontSize="11"
                         Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"
                         Padding="8,0" />
            </Grid>
          </Border>

          <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" HorizontalAlignment="Center"
                      VerticalAlignment="Center" MaxWidth="300">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36" Opacity="0.25" HorizontalAlignment="Center"
                       Margin="0,0,0,12" />
            <TextBlock Text="No secrets yet" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Add your first secret. Values are never shown after saving." FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,0,0,16" />
            <Button x:Name="EmptyAddButton" Content="+ Add secret" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" IsEnabled="False" Click="AddSecretButton_Click" />
          </StackPanel>

          <ScrollViewer x:Name="ListScrollViewer" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SecretsList" Margin="8">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4"
                          MouseLeftButtonUp="SecretCard_MouseLeftButtonUp" Cursor="Hand">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="#333840" />
                            <Setter Property="BorderBrush" Value="#6060CDFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Opacity="0.55"
                                 Margin="0,0,10,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}"
                              IsEnabled="{Binding CanDelete}" Click="DeleteButton_Click"
                              Margin="12,0,0,0" VerticalAlignment="Center"
                              ToolTip="Select this card first, then click Delete or press Del">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Delete" />
                          <Border Style="{StaticResource KeyChipStyle}">
                            <TextBlock Text="Del" Style="{StaticResource KeyChipTextStyle}" />
                          </Border>
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- Secret Gates (live, read-only policy browser; issue #119) -->
        <DockPanel x:Name="PageGates" Visibility="Collapsed" LastChildFill="True">
          <DockPanel.Resources>
            <DataTemplate x:Key="LevelRowTemplate">
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" Style="{StaticResource BrandIconStyle}" />
                  <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="999" Padding="9,3" Background="{Binding PillBg}"
                        VerticalAlignment="Center" ToolTip="{Binding Tip}">
                  <TextBlock Text="{Binding Pill}" FontSize="11" FontWeight="Bold" Foreground="{Binding PillFg}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11.5" Margin="10,0,0,0" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"
                           Visibility="{Binding NoteVisibility}" />
              </Grid>
            </DataTemplate>
            <Style TargetType="Button" x:Key="LevelPillButtonStyle">
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="999" Padding="9,3" Background="{Binding PillBg}"
                            BorderBrush="Transparent" BorderThickness="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Pill}" FontSize="11" FontWeight="Bold" Foreground="{Binding PillFg}" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8"
                                   Margin="6,1,0,0" VerticalAlignment="Center" Foreground="{Binding PillFg}" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="BorderBrush" Value="{Binding PillFg}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="bd" Property="BorderBrush" Value="White" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <DataTemplate x:Key="LauncherLevelRowTemplate">
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" Style="{StaticResource BrandIconStyle}" />
                  <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource LevelPillButtonStyle}" VerticalAlignment="Center"
                        ToolTip="{Binding Tip}" Click="LevelPill_Click"
                        AutomationProperties.Name="{Binding Label, StringFormat='Set the {0} level'}" />
                <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11.5" Margin="10,0,0,0" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"
                           Visibility="{Binding NoteVisibility}" />
              </Grid>
            </DataTemplate>
          </DockPanel.Resources>

          <Border x:Name="GatesErrorBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                  Background="#14FF6B6B" BorderBrush="#26FF6B6B" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="&#9888;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top"
                         Foreground="{StaticResource DangerBrush}" />
              <TextBlock x:Name="GatesErrorText" FontSize="12" Foreground="#BFFFFFFF"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
              <Border x:Name="GatesDefaultsCard" Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12"
                      Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Defaults" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Level an enrolled launcher gets for every tool until cw policy set overrides it. Anything not auto-allowed goes to the Approval Gate, or is blocked when no UI is available."
                             FontSize="12" Margin="0,6,0,4" TextWrapping="Wrap"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <ItemsControl x:Name="GatesDefaults" ItemTemplate="{StaticResource LevelRowTemplate}" />
                  <TextBlock Text="Change a level: click it on a launcher card, or run cw policy set &lt;policyKey&gt; &lt;tool&gt; &lt;level&gt;"
                             FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" FontStyle="Italic"
                             Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
              </Border>

              <Border x:Name="GatesSessionsCard" Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12"
                      Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Active session allows" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Launcher grants from the Approval Gate's &quot;Allow for session&quot; button. Each ends when the launcher exits, after 60 idle minutes, or at the time chosen in the popup."
                             FontSize="12" Margin="0,6,0,4" TextWrapping="Wrap"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock x:Name="GatesSessionsStatus" FontSize="12" Margin="0,6,0,0"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <ItemsControl x:Name="GatesSessions">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                                Padding="0,8,0,0" Margin="0,8,0,0">
                          <StackPanel>
                            <TextBlock Text="{Binding Id}" FontSize="12.5" FontWeight="SemiBold"
                                       FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Scope}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Times}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Run cw policy sessions --revoke &lt;id&gt;"
                             FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" FontStyle="Italic"
                             Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
              </Border>

              <StackPanel x:Name="GatesEmpty" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="No launchers enrolled" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Every tool resolves to Deny until a launcher is enrolled."
                           FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Enroll a launcher: + Enroll launcher (Ctrl+E), or cw policy enroll --kind terminal|ai-harness"
                           FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" FontStyle="Italic"
                           Foreground="{StaticResource TextTertiaryBrush}" />
              </StackPanel>

              <ItemsControl x:Name="GatesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{Binding CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                            Cursor="Hand" MouseLeftButtonUp="LauncherCard_MouseLeftButtonUp">
                      <StackPanel>
                        <DockPanel LastChildFill="True">
                          <Button DockPanel.Dock="Right" Style="{StaticResource DangerButtonStyle}" Margin="10,0,0,0"
                                  Padding="10,4" VerticalAlignment="Center" Click="UnenrollButton_Click"
                                  ToolTip="Unenroll this launcher (select it, then Del)" AutomationProperties.Name="Unenroll">
                            <TextBlock Text="Unenroll" FontSize="11.5" />
                          </Button>
                          <Border DockPanel.Dock="Right" CornerRadius="999" Padding="9,3" Margin="10,0,0,0"
                                  VerticalAlignment="Center" Background="{Binding KindBg}">
                            <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="Bold" Foreground="{Binding KindFg}" />
                          </Border>
                          <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0"
                                 Style="{StaticResource BrandIconStyle}" />
                          <TextBlock Text="{Binding Key}" ToolTip="{Binding Key}" FontSize="14" FontWeight="SemiBold"
                                     FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Path}" ToolTip="{Binding FullPath}" FontSize="12" Margin="0,4,0,2"
                                   Foreground="{StaticResource TextTertiaryBrush}" Visibility="{Binding PathVisibility}" />
                        <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource LauncherLevelRowTemplate}" />
                        <TextBlock Text="{Binding Hint}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                                   FontStyle="Italic" Foreground="{StaticResource TextTertiaryBrush}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <ScrollViewer x:Name="PageDetectors" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20">
            <TextBlock x:Name="DetectorsHeadline" FontSize="15" FontWeight="SemiBold" Text="Scanning..." Margin="0,0,0,12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock x:Name="DetectorsHeadlineSub" FontSize="12" Margin="0,-8,0,14" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"
                       Text="Nothing to fix. Findings appear here when a detector reports a risk." />
            <ItemsControl x:Name="DetectorsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                          BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" Style="{StaticResource BrandIconStyle}" />
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Tool}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                      </StackPanel>
                      <Border CornerRadius="999" Padding="9,3" Margin="0,8,0,0" HorizontalAlignment="Left"
                              Background="{Binding PillBg}">
                        <TextBlock Text="{Binding Pill}" FontSize="11" FontWeight="Bold" Foreground="{Binding PillFg}" />
                      </Border>
                      <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                 Foreground="{StaticResource TextSecondaryBrush}" />
                      <TextBlock Text="{Binding Evidence}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextTertiaryBrush}" />
                      <TextBlock Text="{Binding Remediation}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                 Visibility="{Binding RemediationVisibility}" />
                      <TextBlock Text="{Binding Hint}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                 FontStyle="Italic" Foreground="{StaticResource TextTertiaryBrush}"
                                 Visibility="{Binding HintVisibility}" />
                      <Button Content="Move to vault" Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding Fix}"
                              HorizontalAlignment="Left" Margin="0,10,0,0" Click="MoveToVault_Click"
                              Visibility="{Binding FixVisibility}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Hardened Tools (live, read-only) -->
        <ScrollViewer x:Name="PageTools" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ToolsList" Margin="20">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="32" Height="32" CornerRadius="8" Padding="6" Margin="0,0,12,0"
                              Background="{StaticResource MutedPillBrush}" VerticalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Image Source="{Binding Icon}" Style="{StaticResource BrandIconStyle}" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Id}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Path}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Path}" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Border CornerRadius="999" Padding="9,3" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Background="{Binding PillBg}">
                      <TextBlock Text="{Binding Pill}" FontSize="11" FontWeight="Bold" Foreground="{Binding PillFg}" />
                    </Border>
                    <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               FontStyle="Italic" Foreground="{StaticResource TextTertiaryBrush}"
                               Visibility="{Binding NoteVisibility}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Secret Usage (live, read-only) -->
        <DockPanel x:Name="PageUsage" Visibility="Collapsed" LastChildFill="True">
          <Border x:Name="UsageErrorBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                  Background="#14FF6B6B" BorderBrush="#26FF6B6B" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="&#9888;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top"
                         Foreground="{StaticResource DangerBrush}" />
              <TextBlock x:Name="UsageErrorText" FontSize="12" Foreground="#BFFFFFFF"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <TextBlock x:Name="UsageFooter" DockPanel.Dock="Bottom" FontSize="11" Padding="20,8,20,12"
                     Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" />

          <StackPanel x:Name="UsageEmpty" Visibility="Collapsed" HorizontalAlignment="Center"
                      VerticalAlignment="Center" MaxWidth="320">
            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36" Opacity="0.25" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="No secret usage recorded yet" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Gate decisions appear here after a hardened tool runs. Values are never shown."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       TextAlignment="Center" />
          </StackPanel>

          <ScrollViewer x:Name="UsageScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="UsageList" Margin="12,8" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                          BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4,3">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="1.4*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" SharedSizeGroup="UsageDecision" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                          <Image DockPanel.Dock="Left" Source="{Binding LauncherIcon}" Width="16" Height="16" Margin="0,0,8,0"
                                 Style="{StaticResource BrandIconStyle}" />
                          <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Launcher, Mode=OneWay}" />
                            <Run Text="{Binding LauncherKind, Mode=OneWay}" Foreground="{StaticResource TextTertiaryBrush}" />
                          </TextBlock>
                        </DockPanel>
                        <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                          <Image DockPanel.Dock="Left" Source="{Binding ToolIcon}" Width="14" Height="14" Margin="0,0,6,0"
                                 Style="{StaticResource BrandIconStyle}" />
                          <TextBlock Text="{Binding ToolClass}" FontSize="12" FontWeight="SemiBold"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Secret}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                          <Border CornerRadius="999" Padding="9,3" Background="{Binding PillBg}">
                            <TextBlock Text="{Binding Pill}" FontSize="11" FontWeight="Bold" Foreground="{Binding PillFg}" />
                          </Border>
                          <TextBlock Text="{Binding Reason}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                      </Grid>
                    <TextBlock Text="{Binding AgentSays}" Visibility="{Binding AgentSaysVisibility}" FontSize="11"
                               Margin="110,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- Doctor (live, read-only) -->
        <ScrollViewer x:Name="PageDoctor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <ScrollViewer.Resources>
            <Style x:Key="DoctorCard" TargetType="Border">
              <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="CornerRadius" Value="12" />
              <Setter Property="Padding" Value="16" />
              <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
              <Setter Property="FontSize" Value="15" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CardMuted" TargetType="TextBlock">
              <Setter Property="FontSize" Value="12" />
              <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
              <Setter Property="Margin" Value="0,6,0,0" />
              <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardHint" TargetType="TextBlock" BasedOn="{StaticResource CardMuted}">
              <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
              <Setter Property="FontStyle" Value="Italic" />
            </Style>
            <Style x:Key="Pill" TargetType="Border">
              <Setter Property="CornerRadius" Value="999" />
              <Setter Property="Padding" Value="9,3" />
              <Setter Property="Margin" Value="0,10,8,0" />
              <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="PillText" TargetType="TextBlock">
              <Setter Property="FontSize" Value="11" />
              <Setter Property="FontWeight" Value="Bold" />
            </Style>
          </ScrollViewer.Resources>
          <StackPanel Margin="20">
            <Border Style="{StaticResource DoctorCard}">
              <StackPanel>
                <TextBlock Text="Session Agent" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="DoctorAgentPipe" Style="{StaticResource CardMuted}" Text="Checking..." />
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="DoctorAgentPill" Style="{StaticResource Pill}" Background="{StaticResource MutedPillBrush}">
                    <TextBlock x:Name="DoctorAgentPillText" Style="{StaticResource PillText}" Text="Checking..." Foreground="{StaticResource TextSecondaryBrush}" />
                  </Border>
                  <Border x:Name="DoctorVersionPill" Style="{StaticResource Pill}" Background="{StaticResource WarnDimBrush}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PillText}" Text="Version mismatch" Foreground="{StaticResource WarnBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock x:Name="DoctorAgentDetail" Style="{StaticResource CardMuted}" Visibility="Collapsed" />
                <TextBlock x:Name="DoctorAgentHint" Style="{StaticResource CardHint}" Visibility="Collapsed"
                           Text="Run cw doctor in a terminal to start it." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource DoctorCard}">
              <StackPanel>
                <TextBlock Text="Vault UI binary" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="DoctorVaultPath" Style="{StaticResource CardMuted}" Text="Checking..." />
                <Border x:Name="DoctorVaultPill" Style="{StaticResource Pill}" Background="{StaticResource MutedPillBrush}">
                  <TextBlock x:Name="DoctorVaultPillText" Style="{StaticResource PillText}" Text="Checking..." Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource DoctorCard}">
              <StackPanel>
                <TextBlock Text="Start Menu shortcut" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="DoctorShortcutPath" Style="{StaticResource CardMuted}" Text="Checking..." />
                <Border x:Name="DoctorShortcutPill" Style="{StaticResource Pill}" Background="{StaticResource MutedPillBrush}">
                  <TextBlock x:Name="DoctorShortcutPillText" Style="{StaticResource PillText}" Text="Checking..." Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
                <TextBlock x:Name="DoctorShortcutHint" Style="{StaticResource CardHint}" Visibility="Collapsed"
                           Text="Run cw shortcut install." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource DoctorCard}">
              <StackPanel>
                <TextBlock Text="Details" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                <ItemsControl x:Name="DoctorDetails">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="180" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
