<Window x:Class="CmdWarden.SecretsManager.AddSecretWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add secret"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1C1C1C"
        Foreground="White"
        FontFamily="Segoe UI Variable, Segoe UI"
        ShowInTaskbar="False">
  <Border Margin="16" Background="#2A2A2A" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="10" Padding="20">
    <StackPanel>
      <TextBlock Text="Add secret" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
      <TextBlock Text="Values are never shown again after you save." FontSize="12"
                 Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

      <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBox x:Name="NameBox" Padding="10,8" FontSize="13" Background="#1A1A1A" Foreground="White"
               BorderBrush="#33FFFFFF" CaretBrush="White" TextChanged="Fields_Changed" />
      <TextBlock x:Name="NameError" FontSize="11" Foreground="#FF8A8A" TextWrapping="Wrap"
                 Margin="0,6,0,0" Visibility="Collapsed" />

      <TextBlock Text="Value" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,6" />
      <PasswordBox x:Name="ValueBox" Padding="10,8" FontSize="13" Background="#1A1A1A" Foreground="White"
                   BorderBrush="#33FFFFFF" CaretBrush="White" PasswordChanged="Fields_Changed" />
      <TextBlock x:Name="ValueError" FontSize="11" Foreground="#FF8A8A" TextWrapping="Wrap"
                 Margin="0,6,0,0" Visibility="Collapsed" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"
                IsCancel="True" Click="Cancel_Click" Padding="16,8" ToolTip="Cancel (Esc)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Cancel" />
            <Border Style="{StaticResource KeyChipStyle}">
              <TextBlock Text="Esc" Style="{StaticResource KeyChipTextStyle}" />
            </Border>
          </StackPanel>
        </Button>
        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}"
                IsDefault="True" IsEnabled="False" Click="Save_Click" Padding="18,8" ToolTip="Save (Enter)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Save" />
            <Border Style="{StaticResource KeyChipStyle}">
              <TextBlock Text="Enter" Style="{StaticResource KeyChipTextStyle}" />
            </Border>
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
